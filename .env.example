# ==========================================
# GridShare Environment Configuration
# ==========================================

# Backend Server Config
FLASK_ENV=development
FLASK_APP=gridshare.backend.run:app
PORT=5000
HOST=0.0.0.0
SECRET_KEY=gridshare-super-secret-dev-key

# Database (PostgreSQL URL or SQLite fallback)
# PostgreSQL example: postgresql://postgres:postgres@localhost:5432/gridshare_db
DATABASE_URL=sqlite:///gridshare.db

# MQTT Broker (Optional for simulated live telemetry)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_TELEMETRY=gridshare/telemetry
MQTT_ENABLED=false

# Simulator Settings
SIMULATOR_INTERVAL_SECONDS=3.0
SIMULATOR_API_URL=http://localhost:5000/api/telemetry
SIMULATOR_NUM_HOUSEHOLDS=5
SIMULATOR_BASE_GRID_PRICE=6.10

# Frontend
VITE_API_BASE_URL=http://localhost:5000/api
